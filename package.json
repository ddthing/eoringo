{
  "name": "ff14-daily-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm run test && pnpm run orchestrator:typecheck && pnpm run orchestrator:test && pnpm run orchestrator:build && pnpm run verify:security && pnpm run verify:free-tier && pnpm run build && pnpm run verify:bundle",
    "preview": "vite preview",
    "supabase:reset": "supabase db reset --local",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "test:db": "supabase test db",
    "test:migration-local": "node scripts/test-local-migration.mjs",
    "orchestrator:build": "pnpm --dir tools/codex-orchestrator run build",
    "orchestrator:typecheck": "pnpm --dir tools/codex-orchestrator run typecheck",
    "orchestrator:test": "pnpm --dir tools/codex-orchestrator run test",
    "orchestrator:mock": "pnpm --dir tools/codex-orchestrator run test:mock",
    "orchestrator:doctor": "pnpm --dir tools/codex-orchestrator run cli -- doctor",
    "test": "vitest run",
    "verify:bundle": "node scripts/verify-no-secrets.mjs dist",
    "verify:free-tier": "node scripts/verify-no-paid-features.mjs",
    "verify:security": "node scripts/verify-no-secrets.mjs src supabase scripts tools docs .env.example"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@vitejs/plugin-react": "^4.3.4",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}

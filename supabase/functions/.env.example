# Optional: defaults safely to https://eoringo.pages.dev when omitted.
ALLOWED_ORIGINS=https://eoringo.pages.dev
ALLOW_LOCAL_ORIGINS=false

# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
# Never copy any service-role value into VITE_* variables or the browser bundle.

# Server-only Web Push configuration. Keep these values in Supabase secrets.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
PUSH_CRON_SECRET=

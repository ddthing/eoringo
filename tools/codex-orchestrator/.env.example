# Optional path to the Codex executable. Default: codex
CODEX_ORCHESTRATOR_CODEX_PATH=codex

# General tests never contact a real account. Set to 1 only for an explicit
# read-only live account/model/rate-limit integration test.
CODEX_ORCHESTRATOR_LIVE_TEST=0

# Internal test hook for a Mock App Server. Do not use in production.
# CODEX_ORCHESTRATOR_APP_SERVER_COMMAND=node
# CODEX_ORCHESTRATOR_APP_SERVER_ARGS=["/absolute/path/to/mock-app-server.mjs"]

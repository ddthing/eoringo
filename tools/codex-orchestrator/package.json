{
  "name": "@eoringo/codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codex-orchestrate": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root . --configLoader runner",
    "test:mock": "vitest run --root . --configLoader runner test/orchestrator.e2e.test.ts",
    "test:integration": "vitest run --root . --configLoader runner test/live-account.integration.test.ts",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
